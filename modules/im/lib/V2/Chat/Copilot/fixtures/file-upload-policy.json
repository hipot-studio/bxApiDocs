		{ "name": "notes.txt", "size": 10, "verdict": "OK" },
		{ "name": "photo.PNG", "size": 500000, "verdict": "OK" },
		{ "name": "data.CSV", "size": 100, "verdict": "OK" },
		{ "name": "boundary.pdf", "size": 5242880, "verdict": "OK" },
		{ "name": "photo.jpeg", "size": 100, "verdict": "OK" },
		{ "name": "legacy.DOC", "size": 100, "verdict": "OK" },
		{ "name": "deck.PPTX", "size": 100, "verdict": "OK" },
		{ "name": "sticker.GIF", "size": 100, "verdict": "OK" },

		{ "name": "virus.exe", "size": 100, "verdict": "INVALID_FILE_FORMAT" },
		{ "name": "archive.zip", "size": 100, "verdict": "INVALID_FILE_FORMAT" },
		{ "name": "report.pdf.exe", "size": 100, "verdict": "INVALID_FILE_FORMAT" },
		{ "name": "readme", "size": 100, "verdict": "INVALID_FILE_FORMAT" },

		{ "name": "big.pdf", "size": 10485761, "verdict": "FILE_TOO_LARGE" },
