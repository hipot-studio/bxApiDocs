{
	"_comment": "Shared test cases for BitrixGPT file upload policy. Keep in sync with the copy in immobile/install/mobileapp/immobile/extensions/im/messenger/lib/copilot/file-validator/fixtures/file-upload-policy.json — any divergence must be caught by CI.",
	"policy": {
		"allowedExtensions": [
